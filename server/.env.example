# ----------------------------------------------------------------------
# AMRUT back office - settings
# Copy this file to ".env" and fill in the values for YOUR server.
# Nothing else in the code needs to change.
# ----------------------------------------------------------------------

# Which port the office runs on
PORT=4000

# Where the office lives in the address bar, e.g. https://amrutmaharashtra.org/office
BASE_PATH=/office

# ---- Database -------------------------------------------------------
# Leave DATABASE_URL empty to use the built-in file database (data/amrut.db).
# Nothing to install - good for trying it out.
#
# For a real server, put your PostgreSQL details here instead:
# DATABASE_URL=postgres://username:password@localhost:5432/amrut
DATABASE_URL=

# ---- Security -------------------------------------------------------
# Leave blank and one is generated automatically on first run.
# Changing it signs everybody out; it does not damage any data.
SESSION_SECRET=

# Set to 1 when the site is served over https (recommended in production)
SECURE_COOKIES=0

# ---- Uploads (used from session 2 onward) ---------------------------
UPLOAD_DIR=data/uploads

# ---- Links out to the public portal (optional) ----------------------
# Lets the office show a "view this story" link as a reader sees it.
# Leave blank and those links are simply not shown.
PORTAL_URL=http://localhost:5173

# Where the old site's photographs are still served from, used for
# thumbnails of stories that came across in the migration.
ARCHIVE_IMAGE_BASE=https://amrutmaharashtra.org/
